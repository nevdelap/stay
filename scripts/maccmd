#!/usr/bin/env bash
# Run a command on a Mac over SSH.
set -euo pipefail

if [ -z "${MAC_DIR:-}" ] || [ -z "${MAC_HOST:-}" ] || [ -z "${MAC_PORT:-}" ] || [ -z "${MAC_USERNAME:-}" ]; then
    echo "maccmd: MAC_DIR, MAC_HOST, MAC_PORT, and MAC_USERNAME must be set in the environment." >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: maccmd <command> [arg...]" >&2
    exit 1
fi

remote_cmd=$(printf '%q ' "$@")

exec ssh -p "$MAC_PORT" "$MAC_USERNAME@$MAC_HOST" -- "cd $(printf '%q' "$MAC_DIR") && export PATH=/usr/local/bin:/opt/homebrew/bin:\$PATH && export CARGO_TARGET_DIR=target-mac && $remote_cmd"
